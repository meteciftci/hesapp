{
  "name": "hesapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local && vite",
    "build": "node scripts/prepare-config.mjs && pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.worker.json",
    "test": "vitest run",
    "prepare": "husky || true",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy:cf": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "jose": "^6.2.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.155.0"
  }
}
