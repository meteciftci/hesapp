{
  // Bu dosya yalnızca yer tutucu içerir; kişisel değer yazmayın.
  // Özel alan adı Cloudflare panelinden bağlanır (README: kurulum).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hesapp",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Giriş korumasını atlatmamak için workers.dev ve önizleme adresleri kapalı.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "TZ": "Europe/Istanbul"
  },
  // Panelde girilen değişkenler (SITE_URL, SETUP_CODE...) dağıtımda silinmesin.
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hesapp",
      // Yer tutucu: gerçek kimlik derlemede D1_DATABASE_ID değişkeninden yazılır.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Vade bildirimi: her gün 06:00 UTC = 09:00 İstanbul.
  "triggers": { "crons": ["0 6 * * *"] },
  "observability": { "enabled": true }
}
